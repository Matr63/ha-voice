# Host visible to Home Assistant / ESP devices
HA_VOICE_HOST=192.168.1.50

# STT (Wyoming ONNX ASR / GigaAM)
STT_MODEL=gigaam-v3-e2e-rnnt
STT_QUANTIZATION=int8
STT_DEVICE=cpu
STT_URI=tcp://0.0.0.0:10305
STT_PORT=10305

# Speaker gate (Wyoming proxy in front of STT)
GATE_URI=tcp://0.0.0.0:10350
GATE_PORT=10350
GATE_UPSTREAM=tcp://stt:10305
GATE_THRESHOLD=0.55
GATE_REQUIRE_MATCH=true

# Kokoro-ru TTS: speaks the assistant replies on the board (Wyoming :10351 optional for Assist)
TTS_ENABLED=true
TTS_VOICE=sveta
TTS_PORT=10351

# Dialogue logger + HTTP API / Ingress UI
DIALOGUE_API_PORT=8088
DIALOGUE_PCM_PORT=10500
DIALOGUE_STT_URI=tcp://stt:10305
DIALOGUE_SAMPLE_RATE=16000
DIALOGUE_VAD_RMS=0.012
DIALOGUE_MIN_SPEECH_MS=400
DIALOGUE_MAX_UTTERANCE_MS=15000
DIALOGUE_SILENCE_MS=700

# Home Assistant (the house: states + services). Long-lived token:
# HA profile -> Security -> Long-lived access tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Assistant: ha (HA conversation agent) | openai (Ollama/OpenAI-compatible) | off
ASSISTANT_BACKEND=ha
HA_AGENT_ID=
LLM_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# Wake word on the PC (openWakeWord in-process): alexa | hey_jarvis | hey_mycroft
WAKE_WORD=alexa
WAKE_BACKEND=local

# Optional external openWakeWord (WAKE_BACKEND=wyoming, profile "oww")
OWW_PORT=10400
OWW_PRELOAD_MODEL=alexa

# Paths (compose volumes)
DATA_DIR=./data
HF_HOME=/data/models
SPEAKERS_DIR=/data/speakers
DIALOGUES_DIR=/data/dialogues
